@{
    string type = Model.Type.ToString().ToLowerInvariant();
    var bsClassName = type switch
    {
        "information" => "info",
        "error" => "danger",
        _ => type,
    };

    // Success and Information toasts are announced politely; Warning and Error interrupt.
    var isUrgent = type is "warning" or "error";
    var role = isUrgent ? "alert" : "status";
    var ariaLive = isUrgent ? "assertive" : "polite";

    var closeButtonClass = bsClassName is "danger" or "success" ? "btn-close btn-close-white" : "btn-close";
    int? milliseconds = Model.Milliseconds;
    var autoHide = milliseconds is > 0;

    // Razor renders data-* attributes even when the value is null, and Bootstrap rejects an empty delay,
    // so data-bs-delay is only added when the toast auto-dismisses.
    var toast = new TagBuilder("div");
    toast.AddCssClass($"toast border-0 shadow message-{type} text-bg-{bsClassName}");
    toast.Attributes["role"] = role;
    toast.Attributes["aria-live"] = ariaLive;
    toast.Attributes["aria-atomic"] = "true";
    toast.Attributes["data-bs-autohide"] = autoHide ? "true" : "false";
    if (autoHide)
    {
        toast.Attributes["data-bs-delay"] = milliseconds.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
}

@toast.RenderStartTag()
    <div class="d-flex">
        <div class="toast-body">
            @Model.Message
        </div>
        <button type="button" class="@closeButtonClass me-2 m-auto" data-bs-dismiss="toast" aria-label="@T["Close"]"></button>
    </div>
@toast.RenderEndTag()
